---
// Page About provisoire (noindex) : la version complète arrive en phase 2.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<BaseLayout title={`About — ${site.name}`} noindex>
  <section class="container stub">
    <h1>About</h1>
    {site.about.paragraphs.map((p) => <p>{p}</p>)}
    <a class="arrow-link label" href={url('/#contact')}>Get in touch <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .stub { padding-block: var(--space-l) var(--space-section); display: grid; gap: 1.2em; justify-items: start; }
  h1 { font-family: var(--font-display); font-size: var(--step-4); }
  p { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3; max-width: 34ch; }
</style>
