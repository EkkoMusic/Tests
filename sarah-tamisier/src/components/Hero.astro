---
import { site } from '../data/site';
import type { ProjectGroup } from './ProjectGrid.astro';

interface Props {
  groups: ProjectGroup[];
}

const { groups } = Astro.props;
const { statement, filtersLabel } = site.hero;
const [first, ...rest] = site.name.split(' ');
---

<section class="hero container" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__name">
    <span>{first}</span> <span>{rest.join(' ')}</span>
  </h1>

  <div class="hero__row">
    {statement && <p class="hero__statement">{statement}</p>}
    <nav class="hero__filters" aria-label={filtersLabel}>
      <ul class="label" role="list">
        {groups.map((g, i) => (
          <li>
            {/* Sans JavaScript : simple lien vers la catégorie. Avec : filtre (voir ProjectGrid). */}
            <a href={`#${g.anchor}`} data-filter={g.id} aria-current={i === 0 ? 'true' : undefined}>
              {g.label}<span class="hero__count">{String(g.projects.length).padStart(2, '0')}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 5vw, 6rem) var(--space-l);
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: var(--step-name);
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin-left: -0.04em; /* aligne optiquement le S sur la marge */
  }
  .hero__name span { white-space: nowrap; }

  .hero__row {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .hero__statement {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 30ch;
  }

  .hero__filters ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.2em;
  }
  .hero__filters a {
    display: inline-block;
    padding-block: 0.3em; /* zone de clic confortable */
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  .hero__filters a::before {
    content: '— ';
    transition: color 200ms var(--ease);
  }
  .hero__filters a:hover { color: var(--foreground); }
  .hero__filters a[aria-current='true'] { color: var(--foreground); }
  .hero__filters a[aria-current='true']::before { color: var(--accent); }

  .hero__count {
    font-size: 0.75em;
    vertical-align: super;
    margin-left: 0.35em;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .hero__row {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      align-items: start;
    }
    .hero__statement { grid-column: 1 / span 6; }
    .hero__filters { grid-column: 8 / -1; margin-top: -0.3em; }
  }
</style>
