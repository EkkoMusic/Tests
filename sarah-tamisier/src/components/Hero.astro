---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import portrait from '../assets/hero/sarah.png';
import type { ProjectGroup } from './ProjectGrid.astro';

interface Props {
  groups: ProjectGroup[];
}

const { groups } = Astro.props;
const { statement, filtersLabel, portraitAlt } = site.hero;
const [first, ...rest] = site.name.split(' ');
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__stage">
    <div class="hero__portrait">
      <Picture
      src={portrait}
      alt={portraitAlt}
      formats={['avif', 'webp']}
      widths={[400, 640, 900, portrait.width]}
      sizes="(min-width: 768px) clamp(220px, 26vw, 460px), 56vw"
      loading="eager"
      fetchpriority="high"
      />
    </div>

    <h1 id="hero-title" class="hero__name">
      <span>{first}</span> <span>{rest.join(' ')}</span>
    </h1>

    <div class="hero__row">
      {statement && <p class="hero__statement">{statement}</p>}
      <nav class="hero__filters" aria-label={filtersLabel}>
        <ul class="label" role="list">
          {groups.map((g, i) => (
            <li>
              {/* Sans JavaScript : simple lien vers la catégorie. Avec : filtre (voir ProjectGrid). */}
              <a href={`#${g.anchor}`} data-filter={g.id} aria-current={i === 0 ? 'true' : undefined}>
                {g.label}<span class="hero__count">{String(g.projects.length).padStart(2, '0')}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Réglages de la composition photo + nom (ratio photo ≈ 1,25) */
    --photo-w: min(56vw, 300px);
    --name-x: calc(var(--photo-w) * 0.3); /* le S démarre au bord du col */
    /* Mobile : taille calculée pour que le nom (≈ 7,8 × sa taille) tienne sur une ligne. */
    --name-size: min(var(--step-name), calc((100vw - 2 * var(--gutter) - var(--name-x)) / 7.9));
    /* Le nom est posé sur le col de Sarah : le col se trouve à ≈ 93 % de la
       largeur de la photo depuis son haut ; on centre la ligne du nom dessus. */
    --name-y: calc(var(--photo-w) * 0.93 - var(--name-size) * 0.5);
    padding-block: var(--space-s) var(--space-l);
  }

  /* Photo, nom et textes sont superposés dans la même cellule de grille. */
  .hero__stage {
    display: grid;
    isolation: isolate; /* limite l'effet de fusion du nom à la photo et au fond */
    background: var(--background); /* indispensable : le nom se fond avec ce fond */
  }
  .hero__stage > * { grid-area: 1 / 1; }

  .hero__portrait {
    width: var(--photo-w);
    height: auto;
    z-index: 0;
  }
  .hero__portrait :global(img) { display: block; width: 100%; height: auto; }

  .hero__name {
    z-index: 1;
    align-self: start;
    margin: var(--name-y) 0 0 var(--name-x);
    font-family: var(--font-display);
    font-size: var(--name-size);
    line-height: 0.92;
    letter-spacing: -0.025em;
    /* Blanc + « difference » : encre sombre sur le papier, claire sur la photo. */
    color: #fff;
    mix-blend-mode: difference;
  }
  .hero__name span { white-space: nowrap; }

  /* Mobile : phrase et filtres passent sous la photo. */
  .hero__stage > .hero__row {
    grid-area: 2 / 1;
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-m);
  }

  .hero__statement {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 30ch;
  }

  .hero__filters ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.2em;
  }
  .hero__filters a {
    display: inline-block;
    padding-block: 0.3em; /* zone de clic confortable */
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  .hero__filters a::before {
    content: '— ';
    transition: color 200ms var(--ease);
  }
  .hero__filters a:hover { color: var(--foreground); }
  .hero__filters a[aria-current='true'] { color: var(--foreground); }
  .hero__filters a[aria-current='true']::before { color: var(--accent); }

  .hero__count {
    font-size: 0.75em;
    vertical-align: super;
    margin-left: 0.35em;
    color: var(--muted);
  }

  /* Tablette et desktop : phrase et filtres sous la photo, sur deux colonnes
     (le nom, posé sur le col, occupe maintenant la droite de la photo). */
  @media (min-width: 768px) {
    .hero {
      --photo-w: clamp(220px, 26vw, 460px);
      --name-x: calc(var(--photo-w) * 0.3);
      --name-size: var(--step-name);
    }
    .hero__stage > .hero__row {
      grid-template-columns: 1fr auto;
      column-gap: var(--gutter);
      align-items: end;
    }
  }
  @media (min-width: 768px) and (max-width: 1099px) {
    .hero__stage > .hero__row { grid-template-columns: 1fr; }
  }
</style>
