---
import { site } from '../data/site';
import { url } from '../lib/url';

const { title, paragraphs, moreLabel, moreHref } = site.about;
---

<section class="about container" id="about" aria-labelledby="about-title">
  <h2 id="about-title" class="label about__title">{title}</h2>
  <div class="about__body">
    {paragraphs.map((p) => <p>{p}</p>)}
    <a class="arrow-link label" href={url(moreHref)}>{moreLabel} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-m);
    padding-top: var(--space-section);
  }
  .about__title {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-s);
  }
  .about__body {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    max-width: 34ch;
  }
  .about__body p + p { margin-top: 0.8em; }
  .about__body .arrow-link { margin-top: var(--space-m); }

  @media (min-width: 1024px) {
    .about {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--gutter);
      border-top: 1px solid var(--rule);
      padding-top: var(--space-s);
      margin-top: var(--space-section);
    }
    .about__title { grid-column: 1 / span 3; border: 0; padding-top: 0; }
    .about__body { grid-column: 4 / span 8; padding-top: var(--space-l); }
  }
</style>
